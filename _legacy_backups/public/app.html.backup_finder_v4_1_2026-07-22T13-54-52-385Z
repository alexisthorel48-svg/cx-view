<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CX-View Admin</title>
<link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div id="app">
  <nav class="sidebar">
    <div class="sidebar-logo"><svg class="logo-mark" viewBox="0 0 40 36" aria-label="CX-View"><path fill="#FFD21A" d="M20 1L39 35H1z"/><path fill="#1E293B" d="M20 11l7 13H13z"/></svg><span class="logo-text">CX-View</span></div>
    <ul class="nav-links">
      <li><a href="#" data-page="dashboard" class="active"><span class="icon">📊</span>Tableau de bord</a></li>
      <li><a href="#" data-page="clients"><span class="icon">👥</span>Clients</a></li>
      <li><a href="#" data-page="media"><span class="icon">🗂️</span>Médiathèque</a></li>
      <li><a href="#" data-page="playlists"><span class="icon">▶️</span>Playlists</a></li>
      <li><a href="#" data-page="screens"><span class="icon">🖥️</span>Écrans</a></li>
      <li><a href="#" data-page="stats"><span class="icon">📈</span>Statistiques</a></li>
      <li><a href="#" data-page="history"><span class="icon">📋</span>Historique</a></li>
      <li class="super-only" style="display:none"><a href="#" data-page="accounts"><span class="icon">🔑</span>Comptes</a></li>
    </ul>
    <div class="sidebar-footer">
      <span id="user-name"></span>
      <a href="/logout" class="logout-btn">Déconnexion</a>
    </div>
  </nav>
  <main class="main-content">
    <div id="page-dashboard" class="page active"></div>
    <div id="page-clients" class="page"></div>
    <div id="page-media" class="page"></div>
    <div id="page-playlists" class="page"></div>
    <div id="page-screens" class="page"></div>
    <div id="page-stats" class="page"></div>
    <div id="page-history" class="page"></div>
    <div id="page-accounts" class="page"></div>
  </main>
</div>

<div id="modal-overlay" class="modal-overlay" onclick="closeModal()">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-header">
      <h3 id="modal-title"></h3>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div id="modal-body" class="modal-body"></div>
  </div>
</div>

<div id="picker-overlay" class="modal-overlay" onclick="closePicker()">
  <div class="modal modal-wide" onclick="event.stopPropagation()">
    <div class="modal-header">
      <h3>Sélectionner des médias</h3>
      <button class="modal-close" onclick="closePicker()">✕</button>
    </div>
    <div class="modal-body">
      <div class="picker-filters">
        <input type="text" id="picker-search" placeholder="Rechercher..." oninput="filterPicker()">
        <select id="picker-type" onchange="filterPicker()">
          <option value="">Tous les types</option>
          <option value="IMAGE">Images</option>
          <option value="VIDEO">Vidéos</option>
        </select>
        <select id="picker-client" onchange="filterPicker()">
          <option value="">Tous les clients</option>
        </select>
      </div>
      <div id="picker-grid" class="media-grid"></div>
      <div class="picker-actions">
        <span id="picker-count" style="color:var(--text2);font-size:.85rem"></span>
        <button class="btn btn-secondary" onclick="closePicker()">Annuler</button>
        <button class="btn btn-primary" onclick="confirmPicker()">Ajouter la sélection</button>
      </div>
    </div>
  </div>
</div>

<script src="/js/api.js"></script>
<script src="/js/dashboard.js"></script>
<script src="/js/clients.js"></script>
<script src="/js/media.js"></script>
<script src="/js/playlists.js"></script>
<script src="/js/screens.js"></script>
<script src="/js/stats.js"></script>
<script src="/js/history.js"></script>
<script src="/js/accounts.js"></script>
<script src="/js/app.js"></script>
  <script src="/js/reset_logs.js"></script>
<script src="/js/cx_view_v3.js"></script>
<script src="/js/cx_view_v31.js"></script>
</body>
</html>
